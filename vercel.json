{
  "outputDirectory": "_site",
  "buildCommand": null,
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/notebooks/site_libs/(.*)", "destination": "/site_libs/$1" },
    { "source": "/notebooks/beginner/site_libs/(.*)", "destination": "/site_libs/$1" },
    { "source": "/notebooks/intermediate/site_libs/(.*)", "destination": "/site_libs/$1" },
    { "source": "/notebooks/advanced/site_libs/(.*)", "destination": "/site_libs/$1" },
    { "source": "/notebooks/ai/site_libs/(.*)", "destination": "/site_libs/$1" },
    { "source": "/resources/site_libs/(.*)", "destination": "/site_libs/$1" }
  ]
}
